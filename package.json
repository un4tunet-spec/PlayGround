{
  "name": "hangar7-engine-teardown",
  "version": "1.0.0",
  "description": "Hangar 7: Jet Engine Teardown — 3D desktop mechanic game (Three.js + Electron)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "electron": "npm run build && electron electron/main.js",
    "dist-desktop": "npm run build && electron-packager ./dist Hangar7 --platform=all --arch=x64 --out=release --overwrite"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "electron": "^31.0.0",
    "electron-packager": "^17.1.2"
  }
}
